---
---
<section class="py-20 bg-brand-bglighter">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-4xl font-bold text-brand-navydark font-heading mb-4">Get Started</h2>
        <p class="text-gray-500 font-body mb-6">Ready to schedule service or have a question? Our team is here to help. Contact us today for a free quote.</p>
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-brand-navy flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
            <a href="tel:+14809352176" class="font-body font-semibold text-brand-navy text-lg">(480) 935-2176</a>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-brand-navy flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
            <span class="font-body text-gray-600">843 W Southern Ave, Mesa, AZ 85210</span>
          </div>
        </div>
      </div>
      <div class="bg-brand-formblue rounded-2xl p-8 shadow-2xl">
        <form action="https://formsubmit.co/roccify@gmail.com" method="POST">
          <input type="hidden" name="_next" value="/thank-you" />
          <input type="hidden" name="_captcha" value="false" />
          <div class="grid grid-cols-2 gap-4 mb-4">
            <input type="text" name="name" placeholder="Name" required class="col-span-1 bg-transparent border-b border-white/50 text-white placeholder-white/70 font-body text-sm py-2 focus:outline-none focus:border-white transition-colors" />
            <input type="email" name="email" placeholder="Email Address" required class="col-span-1 bg-transparent border-b border-white/50 text-white placeholder-white/70 font-body text-sm py-2 focus:outline-none focus:border-white transition-colors" />
          </div>
          <div class="mb-4">
            <input type="tel" name="phone" placeholder="Phone Number" class="w-full bg-transparent border-b border-white/50 text-white placeholder-white/70 font-body text-sm py-2 focus:outline-none focus:border-white transition-colors" />
          </div>
          <div class="mb-6">
            <textarea name="message" placeholder="Message" rows="3" class="w-full bg-transparent border-b border-white/50 text-white placeholder-white/70 font-body text-sm py-2 focus:outline-none focus:border-white transition-colors resize-none"></textarea>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="bg-white text-brand-navy font-heading font-bold text-sm px-8 py-3 rounded-full hover:bg-brand-orange hover:text-white transition-all duration-200 shadow-md">SUBMIT</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
