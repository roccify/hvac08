---
import MainLayout from '../layouts/MainLayout.astro';
import GetStarted from '../components/GetStarted.astro';
---
<MainLayout title="About Summit Climate Solutions | HVAC Mesa, AZ" description="Learn about Summit Climate Solutions, licensed HVAC specialists serving Mesa, AZ since 2011. Energy-efficient systems, NATE-certified technicians, no subcontractors.">

  <!-- PAGE HERO -->
  <section class="hero-bg py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="hidden lg:block">
        <img src="/images/about01.jpg" alt="Summit Climate Solutions HVAC unit installed at a Mesa home" class="rounded-2xl shadow-xl object-cover w-full max-h-96" />
      </div>
      <div>
        <h1 class="text-5xl font-heading font-bold text-brand-navydark leading-tight mb-4">About<br/><span class="text-brand-navy">Us</span></h1>
        <p class="text-gray-500 font-body mb-6">HVAC specialists serving Mesa and the East Valley since 2011.</p>
        <a href="/contact" class="btn-orange mr-3">Request Service</a>
        <a href="tel:+14809352176" class="inline-flex items-center gap-2 text-brand-navy font-semibold font-body text-sm mt-3">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          (480) 935-2176
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT STORY -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-brand-orange font-body text-xs font-semibold uppercase tracking-widest mb-3 block">Our Story</span>
          <h2 class="text-3xl font-heading font-bold text-brand-navydark mb-5">Serving Mesa Since 2011</h2>
          <p class="text-gray-500 font-body text-sm leading-relaxed mb-4">Summit Climate Solutions was founded with a single focus: provide honest, effective HVAC services to homeowners and businesses in Mesa and the surrounding East Valley communities.</p>
          <p class="text-gray-500 font-body text-sm leading-relaxed mb-4">Arizona's extreme heat demands more from HVAC systems than almost anywhere else in the country. We built our entire service model around that reality — using high-efficiency equipment, detailed diagnostics, and transparent communication on every job.</p>
          <p class="text-gray-500 font-body text-sm leading-relaxed mb-8">We use only in-house technicians. No subcontractors. That means consistent quality and direct accountability on every project we take on.</p>
          <a href="/services" class="btn-orange">View Our Services</a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <img src="/images/about02.jpg" alt="HVAC technician at a service vehicle" class="rounded-xl shadow-md object-cover w-full h-48" />
          <img src="/images/about03.jpg" alt="Outdoor HVAC unit installation" class="rounded-xl shadow-md object-cover w-full h-48 mt-6" />
          <img src="/images/about04.jpg" alt="Technician servicing heating system" class="rounded-xl shadow-md object-cover w-full h-48 -mt-4" />
          <img src="/images/about05.jpg" alt="HVAC technician performing diagnostics" class="rounded-xl shadow-md object-cover w-full h-48 mt-2" />
        </div>
      </div>
    </div>
  </section>

  <!-- CREDENTIALS & VALUES -->
  <section class="py-20 bg-brand-bglighter">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="section-title">Credentials &amp; Values</h2>
        <p class="section-subtitle">Licensed, certified, and committed to quality on every job.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { icon: '📋', title: 'AZ ROC Licensed', desc: 'Arizona ROC License #318204. Fully licensed for residential and commercial HVAC work in Arizona.' },
          { icon: '🌡️', title: 'EPA Certified', desc: 'EPA Section 608 Certification. Qualified to handle all refrigerant types in compliance with federal regulations.' },
          { icon: '⭐', title: 'NATE Certified', desc: 'NATE-certified technicians with demonstrated knowledge in HVAC installation and service.' },
          { icon: '🛡️', title: 'Fully Insured', desc: 'General liability insurance on all projects. You are protected on every service call.' },
        ].map(c => (
          <div class="bg-white rounded-xl p-6 shadow-sm text-center flex flex-col items-center">
            <div class="w-14 h-14 rounded-full border-2 border-brand-orange flex items-center justify-center text-2xl mb-4">{c.icon}</div>
            <h3 class="font-heading font-bold text-brand-navydark text-sm mb-2">{c.title}</h3>
            <p class="text-gray-500 font-body text-xs leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- QUICK FACTS -->
  <section class="py-20 bg-gradient-to-br from-brand-navydark to-brand-formblue">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-heading font-bold text-white">Quick Facts</h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {[
          { number: '2011', label: 'Founded' },
          { number: '6', label: 'Services Offered' },
          { number: '5', label: 'Cities Served' },
          { number: '100%', label: 'In-House Technicians' },
        ].map(f => (
          <div>
            <div class="text-4xl font-heading font-bold text-brand-orange mb-2">{f.number}</div>
            <div class="text-white/80 font-body text-sm">{f.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICE AREA -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="section-title mb-3">Service Area</h2>
      <p class="text-gray-500 font-body text-sm mb-6">We serve homeowners and businesses throughout Mesa and the surrounding East Valley communities.</p>
      <div class="flex flex-wrap justify-center gap-3">
        {['Mesa', 'Gilbert', 'Chandler', 'Tempe', 'Queen Creek'].map(city => (
          <span class="bg-brand-bglight text-brand-navy font-body font-semibold text-sm px-5 py-2 rounded-full">{city}, AZ</span>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="py-20" style="background: linear-gradient(135deg, #E8914A 0%, #F0A050 100%);">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-heading font-bold text-white mb-10">What Customers Say</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { quote: "Summit Climate installed a new AC system in our home and we couldn't be happier. Professional, clean, and on time.", name: 'David R.', location: 'Mesa, AZ', stars: '★★★★★' },
          { quote: "Our AC broke in the middle of July. Summit Climate came out the same day and had it running again within hours.", name: 'Lisa M.', location: 'Gilbert, AZ', stars: '★★★★★' },
        ].map(t => (
          <div class="bg-white/15 rounded-xl p-6 text-left">
            <p class="text-white font-body text-sm leading-relaxed mb-4 italic">"{t.quote}"</p>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-white font-heading font-bold text-sm">{t.name}</p>
                <p class="text-white/70 text-xs font-body">{t.location}</p>
              </div>
              <span class="text-yellow-200 text-sm">{t.stars}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <GetStarted />

</MainLayout>
