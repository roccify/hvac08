---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout title="Contact" description="Contact Summit Climate Solutions in Mesa, AZ. Call (480) 935-2176 or send a message for HVAC service, repairs, or a free estimate.">
  <Header />

  <!-- PAGE HERO -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, #EEF4FB 0%, #F5F9FF 100%); min-height: 280px;">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-14 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div class="relative rounded-2xl overflow-hidden shadow-xl" style="height: 240px;">
          <img src="/images/equipment01.jpg" alt="HVAC equipment at a Mesa property" class="w-full h-full object-cover" />
          <div class="absolute inset-0" style="background: rgba(30,78,121,0.15);"></div>
        </div>
        <div>
          <h1 class="font-heading font-800 text-5xl leading-tight text-brand-navydark mb-2">Contact</h1>
          <h1 class="font-heading font-800 text-5xl leading-tight text-brand-navy mb-6">Us</h1>
          <a href="/contact#contact-form" class="inline-flex items-center bg-brand-orange hover:bg-brand-orangelight text-white font-heading font-600 px-6 py-3 rounded-full transition-colors text-sm uppercase tracking-wide mb-4">
            Schedule a Free Inspection
          </a>
          <div class="flex items-center gap-2 mt-2">
            <svg class="w-4 h-4 text-brand-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <a href="tel:+14809352176" class="font-heading font-600 text-brand-navy">(480) 935-2176</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEND MESSAGE SPLIT -->
  <section id="contact-form" class="py-0 overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-2">
      <!-- Blue left -->
      <div class="flex flex-col justify-center px-10 py-16" style="background: linear-gradient(135deg, #1F4E79 0%, #1565C0 100%);">
        <h2 class="font-heading font-800 text-4xl text-white leading-tight mb-6">
          Send Us <span class="font-400 italic">a Message</span>
        </h2>
        <p class="font-body text-blue-100 leading-relaxed">
          Have a question about your HVAC system? Need a free estimate? Fill out the form and one of our licensed technicians will get back to you promptly.
        </p>
      </div>
      <!-- Right: form -->
      <div class="bg-white px-10 py-16">
        <form action="https://formsubmit.co/roccify@gmail.com" method="POST" class="space-y-4">
          <input type="hidden" name="_subject" value="New Contact Form — Summit Climate Solutions" />
          <input type="hidden" name="_next" value="/thank-you" />
          <input type="hidden" name="_captcha" value="false" />
          <div>
            <label class="block font-body text-sm text-gray-600 mb-1">Name</label>
            <input type="text" name="name" required class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm font-body focus:outline-none focus:border-brand-navy transition" />
          </div>
          <div>
            <label class="block font-body text-sm text-gray-600 mb-1">Email Address</label>
            <input type="email" name="email" required class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm font-body focus:outline-none focus:border-brand-navy transition" />
          </div>
          <div>
            <label class="block font-body text-sm text-gray-600 mb-1">Phone</label>
            <input type="tel" name="phone" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm font-body focus:outline-none focus:border-brand-navy transition" />
          </div>
          <div>
            <label class="block font-body text-sm text-gray-600 mb-1">Message</label>
            <textarea name="message" rows="4" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm font-body focus:outline-none focus:border-brand-navy transition resize-none"></textarea>
          </div>
          <button type="submit" class="w-full bg-brand-orange hover:bg-brand-orangelight text-white font-heading font-600 py-3 rounded-full transition-colors text-sm tracking-wide uppercase">
            Submit
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- CONTACT INFO CARDS -->
  <section class="py-16 bg-brand-bglight">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Our Office -->
        <div class="bg-white rounded-xl p-6 text-center shadow-sm flex flex-col items-center">
          <div class="w-12 h-12 rounded-full border-2 border-brand-orange flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-brand-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          </div>
          <h4 class="font-heading font-700 text-brand-navydark text-sm mb-1">Our Office</h4>
          <p class="font-body text-xs text-gray-500 leading-relaxed">843 W Southern Ave,<br/>Mesa, AZ 85210</p>
        </div>
        <!-- Call Us -->
        <div class="bg-white rounded-xl p-6 text-center shadow-sm flex flex-col items-center">
          <div class="w-12 h-12 rounded-full border-2 border-brand-orange flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-brand-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <h4 class="font-heading font-700 text-brand-navydark text-sm mb-1">Call Us</h4>
          <a href="tel:+14809352176" class="font-body text-xs text-brand-navy hover:text-brand-navylight transition-colors">(480) 935-2176</a>
        </div>
        <!-- Email Us -->
        <div class="bg-white rounded-xl p-6 text-center shadow-sm flex flex-col items-center">
          <div class="w-12 h-12 rounded-full border-2 border-brand-orange flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-brand-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h4 class="font-heading font-700 text-brand-navydark text-sm mb-1">Email Us</h4>
          <a href="mailto:info@summitclimateaz.com" class="font-body text-xs text-brand-navy hover:text-brand-navylight transition-colors break-all">info@summitclimateaz.com</a>
        </div>
        <!-- Hours -->
        <div class="bg-white rounded-xl p-6 text-center shadow-sm flex flex-col items-center">
          <div class="w-12 h-12 rounded-full border-2 border-brand-orange flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-brand-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h4 class="font-heading font-700 text-brand-navydark text-sm mb-1">Hours</h4>
          <p class="font-body text-xs text-gray-500">Mon–Sat: 8am – 5pm<br/>Sunday: Closed</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Left: orange FAQ -->
        <div class="rounded-xl p-8" style="background: linear-gradient(135deg, #E8914A 0%, #F0A050 100%);">
          <h3 class="font-heading font-700 text-white text-lg mb-4">Why is your service call more expensive than others?</h3>
          <p class="font-body text-orange-50 text-sm leading-relaxed mb-6">Our service fee includes full diagnostics and system evaluation, allowing us to identify root problems rather than providing a quick temporary fix.</p>
          <h3 class="font-heading font-700 text-white text-lg mb-4">Can I just install a unit from a big-box store?</h3>
          <p class="font-body text-orange-50 text-sm leading-relaxed">Retail HVAC units often lack proper warranty support and may not meet local code requirements. Professional installation ensures compliance, safety, and full manufacturer warranty coverage.</p>
        </div>

        <!-- Right: FAQ list -->
        <div>
          <h2 class="font-heading font-800 text-3xl text-brand-navydark mb-6">Frequently Asked Questions</h2>
          <div class="space-y-5">
            <div>
              <h4 class="font-heading font-700 text-brand-navy text-sm mb-2">How quickly can you respond to an AC emergency?</h4>
              <p class="font-body text-sm text-gray-600 leading-relaxed">We offer same-day service for AC repairs whenever possible. Arizona heat doesn't wait, and neither do we.</p>
            </div>
            <div>
              <h4 class="font-heading font-700 text-brand-navy text-sm mb-2">Do you provide free estimates?</h4>
              <p class="font-body text-sm text-gray-600 leading-relaxed">Yes. We offer free quotes on all installations and system replacements. Call or submit the form above to get started.</p>
            </div>
            <div>
              <h4 class="font-heading font-700 text-brand-navy text-sm mb-2">Do you use subcontractors?</h4>
              <p class="font-body text-sm text-gray-600 leading-relaxed">No. All of our technicians are in-house employees. This ensures consistent quality and accountability on every job.</p>
            </div>
            <div>
              <h4 class="font-heading font-700 text-brand-navy text-sm mb-2">What areas do you serve?</h4>
              <p class="font-body text-sm text-gray-600 leading-relaxed">Mesa, Gilbert, Chandler, Tempe, Queen Creek, and surrounding communities in Maricopa County.</p>
            </div>
          </div>
          <a href="/contact#contact-form" class="mt-6 inline-block bg-brand-navy hover:bg-brand-navylight text-white font-heading font-600 px-6 py-3 rounded-full transition-colors text-sm">
            Ask a Question
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- MAP / DIRECTIONS -->
  <section class="py-16 bg-brand-bglight">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="font-heading font-800 text-3xl text-brand-navydark mb-4">Find Us</h2>
          <p class="font-body text-gray-600 leading-relaxed mb-2">843 W Southern Ave, Mesa, AZ 85210</p>
          <p class="font-body text-sm text-gray-500 mb-6">Proudly serving Mesa and surrounding areas in Maricopa County.</p>
          <a
            href="https://www.google.com/maps/search/?api=1&query=843+W+Southern+Ave+Mesa+AZ+85210"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 bg-brand-orange hover:bg-brand-orangelight text-white font-heading font-600 px-6 py-3 rounded-full transition-colors text-sm"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Get Directions
          </a>
        </div>
        <div class="rounded-2xl overflow-hidden shadow-lg" style="height: 280px;">
          <img src="/images/equipment02.jpg" alt="HVAC equipment at a residential property" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom Get Started -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="font-heading font-800 text-4xl text-brand-navydark mb-4">Get Started</h2>
          <p class="font-body text-gray-600 mb-8 leading-relaxed">Ready to improve your comfort? Our team is available Monday through Saturday to take your call or respond to your message.</p>
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-brand-navy flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <a href="tel:+14809352176" class="font-heading font-600 text-brand-navy text-lg">(480) 935-2176</a>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-brand-navy flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
              </div>
              <span class="font-body text-gray-700">843 W Southern Ave, Mesa, AZ 85210</span>
            </div>
          </div>
        </div>
        <div class="rounded-2xl p-8 shadow-xl" style="background: linear-gradient(135deg, #1565C0 0%, #1976D2 50%, #2196F3 100%);">
          <form action="https://formsubmit.co/roccify@gmail.com" method="POST" class="space-y-4">
            <input type="hidden" name="_subject" value="New Contact Request — Summit Climate Solutions" />
            <input type="hidden" name="_next" value="/thank-you" />
            <input type="hidden" name="_captcha" value="false" />
            <div class="grid grid-cols-2 gap-3">
              <input type="text" name="name" placeholder="Name" required class="col-span-2 sm:col-span-1 bg-white bg-opacity-20 border border-white border-opacity-30 rounded-lg px-4 py-2.5 text-white placeholder-white placeholder-opacity-70 text-sm font-body focus:outline-none focus:border-white transition" />
              <input type="email" name="email" placeholder="Email Address" required class="col-span-2 sm:col-span-1 bg-white bg-opacity-20 border border-white border-opacity-30 rounded-lg px-4 py-2.5 text-white placeholder-white placeholder-opacity-70 text-sm font-body focus:outline-none focus:border-white transition" />
            </div>
            <textarea name="message" placeholder="Message" rows="3" class="w-full bg-white bg-opacity-20 border border-white border-opacity-30 rounded-lg px-4 py-2.5 text-white placeholder-white placeholder-opacity-70 text-sm font-body focus:outline-none focus:border-white transition resize-none"></textarea>
            <button type="submit" class="w-full bg-brand-orange hover:bg-brand-orangelight text-white font-heading font-600 py-3 rounded-full transition-colors text-sm tracking-wide uppercase">SUBMIT</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>
