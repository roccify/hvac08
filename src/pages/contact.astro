---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Contact Summit Climate Solutions | HVAC Mesa, AZ" description="Contact Summit Climate Solutions for HVAC service in Mesa, AZ. Call (480) 935-2176 or request service online. Serving Mesa, Gilbert, Chandler, and Tempe.">

  <!-- CONTACT HERO -->
  <section class="hero-bg py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="hidden lg:block">
        <img src="/images/gallery01.jpg" alt="HVAC technician preparing for a service call" class="rounded-2xl shadow-xl object-cover w-full max-h-96" />
      </div>
      <div>
        <h1 class="text-5xl font-heading font-bold text-brand-navydark leading-tight mb-2">Contact<br/><span class="text-brand-navy">Us</span></h1>
        <p class="text-gray-500 font-body mb-6">Ready to schedule service or have a question? Reach out — we respond quickly.</p>
        <a href="/contact#form" class="btn-orange mr-3">Schedule a Free Inspection</a>
        <a href="tel:+14809352176" class="inline-flex items-center gap-2 text-brand-navy font-semibold font-body text-sm mt-3">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          (480) 935-2176
        </a>
      </div>
    </div>
  </section>

  <!-- SEND MESSAGE SPLIT SECTION -->
  <section id="form" class="py-16 bg-white scroll-mt-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 rounded-2xl overflow-hidden shadow-xl">
        <!-- Left blue -->
        <div class="bg-gradient-to-br from-brand-navydark to-brand-formblue p-12 flex flex-col justify-center">
          <h2 class="text-3xl font-heading font-bold text-white mb-4">Send Us a<br/><span class="font-black">Message</span></h2>
          <p class="text-white/80 font-body text-sm leading-relaxed">Fill out the form and one of our HVAC specialists will get back to you shortly. We offer free quotes on all services.</p>
        </div>
        <!-- Right form -->
        <div class="bg-white p-12">
          <form action="https://formsubmit.co/roccify@gmail.com" method="POST" class="space-y-5">
            <input type="hidden" name="_next" value="/thank-you" />
            <input type="hidden" name="_captcha" value="false" />
            <div>
              <label class="block text-sm font-body font-semibold text-gray-700 mb-1">Name</label>
              <input type="text" name="name" required class="w-full border-b border-gray-300 py-2 text-sm font-body focus:outline-none focus:border-brand-navy transition-colors" placeholder="Your full name" />
            </div>
            <div>
              <label class="block text-sm font-body font-semibold text-gray-700 mb-1">Email Address</label>
              <input type="email" name="email" required class="w-full border-b border-gray-300 py-2 text-sm font-body focus:outline-none focus:border-brand-navy transition-colors" placeholder="your@email.com" />
            </div>
            <div>
              <label class="block text-sm font-body font-semibold text-gray-700 mb-1">Phone</label>
              <input type="tel" name="phone" class="w-full border-b border-gray-300 py-2 text-sm font-body focus:outline-none focus:border-brand-navy transition-colors" placeholder="(480) 000-0000" />
            </div>
            <div>
              <label class="block text-sm font-body font-semibold text-gray-700 mb-1">Message</label>
              <textarea name="message" rows="4" class="w-full border-b border-gray-300 py-2 text-sm font-body focus:outline-none focus:border-brand-navy transition-colors resize-none" placeholder="How can we help?"></textarea>
            </div>
            <div class="flex justify-end">
              <button type="submit" class="btn-orange">Submit</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT INFO CARDS (4 cards) -->
  <section class="py-16 bg-brand-bglighter">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { icon: '🏠', title: 'Our Office', lines: ['843 W Southern Ave', 'Mesa, AZ 85210'] },
          { icon: '📞', title: 'Call Us', lines: ['(480) 935-2176', 'Mon–Sat 8AM–5PM'] },
          { icon: '✉️', title: 'Email Us', lines: ['info@summitclimateaz.com'] },
          { icon: '🕐', title: 'Hours', lines: ['Mon–Sat: 8:00 AM – 5:00 PM', 'Sunday: Closed'] },
        ].map(c => (
          <div class="bg-white rounded-xl p-6 shadow-sm text-center flex flex-col items-center">
            <div class="w-14 h-14 rounded-full border-2 border-brand-orange flex items-center justify-center text-2xl mb-3">{c.icon}</div>
            <h3 class="font-heading font-bold text-brand-navydark text-sm mb-2">{c.title}</h3>
            {c.lines.map(l => <p class="text-gray-500 font-body text-xs">{l}</p>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Left: FAQ items on orange bg -->
        <div class="bg-brand-orange rounded-2xl p-8 space-y-6">
          {[
            { q: 'Why is your service call more expensive than others?', a: 'Our service fee includes full diagnostics and system evaluation, allowing us to identify root problems rather than providing a quick temporary fix.' },
            { q: 'Can\'t I just buy and install a unit from a big-box store?', a: 'Retail HVAC units often lack proper local warranty support and may not be installed according to local code requirements. Professional installation ensures compliance and full manufacturer warranty.' },
          ].map(faq => (
            <div>
              <h4 class="font-heading font-bold text-white text-sm mb-2">{faq.q}</h4>
              <p class="text-white/85 font-body text-xs leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>

        <!-- Right: FAQ title + more questions -->
        <div>
          <h2 class="text-3xl font-heading font-bold text-brand-navydark mb-3">Frequently Asked<br/>Questions</h2>
          <p class="text-gray-500 font-body text-sm mb-6">Have a different question? Call us or send a message and we'll get back to you promptly.</p>
          <a href="#form" class="btn-orange mb-8 inline-block">Ask a Question</a>

          <div class="space-y-5">
            {[
              { q: 'Do you offer free quotes?', a: 'Yes. We provide free quotes on all installations and major service work.' },
              { q: 'Do you use subcontractors?', a: 'No. All work is performed by our in-house licensed technicians for consistent quality on every job.' },
              { q: 'What areas do you serve?', a: 'We serve Mesa, Gilbert, Chandler, Tempe, Queen Creek, and surrounding Maricopa County communities.' },
              { q: 'Do you service commercial properties?', a: 'Yes. We provide HVAC services for office buildings, restaurants, warehouses, and retail stores.' },
            ].map(faq => (
              <div class="border-b border-gray-100 pb-4">
                <h4 class="font-heading font-bold text-brand-navydark text-sm mb-1">{faq.q}</h4>
                <p class="text-gray-500 font-body text-xs leading-relaxed">{faq.a}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAP SECTION -->
  <section class="py-16 bg-brand-bglighter">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="section-title mb-3">Find Us</h2>
          <p class="text-gray-500 font-body text-sm mb-2">Proudly serving Mesa and surrounding areas in Maricopa County.</p>
          <p class="text-gray-600 font-body text-sm font-semibold mb-6">843 W Southern Ave, Mesa, AZ 85210</p>
          <a href="https://www.google.com/maps/search/?api=1&query=843+W+Southern+Ave+Mesa+AZ+85210" target="_blank" rel="noopener" class="btn-orange inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
            Get Directions
          </a>
        </div>
        <div class="bg-brand-navydark rounded-2xl p-8 text-center">
          <div class="text-5xl mb-4">📍</div>
          <h3 class="font-heading font-bold text-white text-lg mb-2">Summit Climate Solutions</h3>
          <p class="text-white/70 font-body text-sm">843 W Southern Ave<br/>Mesa, AZ 85210</p>
          <a href="https://www.google.com/maps/search/?api=1&query=843+W+Southern+Ave+Mesa+AZ+85210" target="_blank" rel="noopener" class="btn-orange mt-6 inline-block">Open in Google Maps</a>
        </div>
      </div>
    </div>
  </section>

  <!-- GET STARTED repeat at bottom -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl font-bold text-brand-navydark font-heading mb-4">Get Started</h2>
          <p class="text-gray-500 font-body mb-6">Contact us today. Free quotes available on all services.</p>
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-brand-navy flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
              <a href="tel:+14809352176" class="font-body font-semibold text-brand-navy text-lg">(480) 935-2176</a>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-brand-navy flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
              <span class="font-body text-gray-600">843 W Southern Ave, Mesa, AZ 85210</span>
            </div>
          </div>
        </div>
        <div class="bg-brand-formblue rounded-2xl p-8 shadow-2xl">
          <form action="https://formsubmit.co/roccify@gmail.com" method="POST">
            <input type="hidden" name="_next" value="/thank-you" />
            <input type="hidden" name="_captcha" value="false" />
            <div class="grid grid-cols-2 gap-4 mb-4">
              <input type="text" name="name" placeholder="Name" required class="col-span-1 bg-transparent border-b border-white/50 text-white placeholder-white/70 font-body text-sm py-2 focus:outline-none focus:border-white transition-colors" />
              <input type="email" name="email" placeholder="Email Address" required class="col-span-1 bg-transparent border-b border-white/50 text-white placeholder-white/70 font-body text-sm py-2 focus:outline-none focus:border-white transition-colors" />
            </div>
            <div class="mb-6">
              <textarea name="message" placeholder="Message" rows="3" class="w-full bg-transparent border-b border-white/50 text-white placeholder-white/70 font-body text-sm py-2 focus:outline-none focus:border-white transition-colors resize-none"></textarea>
            </div>
            <div class="flex justify-end">
              <button type="submit" class="bg-white text-brand-navy font-heading font-bold text-sm px-8 py-3 rounded-full hover:bg-brand-orange hover:text-white transition-all duration-200">SUBMIT</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

</MainLayout>
