---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Thank You | Summit Climate Solutions" description="Thank you for contacting Summit Climate Solutions. We will be in touch shortly.">
  <section class="hero-bg min-h-[70vh] flex items-center">
    <div class="max-w-2xl mx-auto px-6 lg:px-8 text-center py-24">
      <div class="text-6xl mb-6">✅</div>
      <h1 class="text-4xl font-heading font-bold text-brand-navydark mb-4">Thank You!</h1>
      <p class="text-gray-500 font-body text-lg mb-3">Your message has been received.</p>
      <p class="text-gray-400 font-body text-sm mb-8">One of our HVAC specialists will get back to you shortly. If you need immediate assistance, please call us directly.</p>
      <a href="tel:+14809352176" class="btn-orange mr-3">(480) 935-2176</a>
      <a href="/" class="btn-outline">Back to Home</a>
    </div>
  </section>
</MainLayout>
