---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout title="Thank You" description="Thank you for contacting Summit Climate Solutions.">
  <Header />

  <section class="min-h-screen flex items-center justify-center py-20" style="background: linear-gradient(135deg, #EEF4FB 0%, #F5F9FF 100%);">
    <div class="max-w-lg mx-auto px-6 text-center">
      <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6" style="background: linear-gradient(135deg, #1F4E79, #1565C0);">
        <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <h1 class="font-heading font-800 text-4xl text-brand-navydark mb-4">Thank You!</h1>
      <p class="font-body text-gray-600 leading-relaxed mb-4">
        Thank you for contacting Summit Climate Solutions. We have received your message and will get back to you shortly.
      </p>
      <p class="font-body text-gray-500 text-sm mb-8">
        For urgent service needs, please call us directly at
        <a href="tel:+14809352176" class="text-brand-navy font-600 hover:text-brand-navylight">(480) 935-2176</a>.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="bg-brand-navy hover:bg-brand-navylight text-white font-heading font-600 px-6 py-3 rounded-full transition-colors text-sm">
          Back to Home
        </a>
        <a href="/services" class="border-2 border-brand-navy text-brand-navy hover:bg-brand-navy hover:text-white font-heading font-600 px-6 py-3 rounded-full transition-colors text-sm">
          View Services
        </a>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>
